# ==============================================================================
# SupplyChain Guardian - Backend Environment Variables
# ==============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=https://nex-chain-ai-6rah.vercel.app

# JWT Secret for Session & Role-Based Authorization
JWT_SECRET=supply_guardian_ultra_secure_jwt_token_secret_key_2026_xyz
JWT_EXPIRES_IN=7d

# Supabase Credentials (Optional: if blank, system runs with autonomous persistent state)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Configuration (Google Gemini / OpenAI / Anthropic)
# If left blank, the deterministic Operations Research optimization core handles all decisions
AI_PROVIDER=LOCAL_OR_GEMINI
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
